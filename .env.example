# Copy to .env (never commit .env). All values blank by design.

# Platform-issued HMAC secret: dashboard -> your agent -> Rotate Secret.
# Shown ONCE by the platform. Preflight fails until this is the real value.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key (free signup at https://kurier.xyz, key from the
# user dashboard). Only needed for the on-chain audit submission of our
# response proofs and VERIFIER_MODE=kurier.
KURIER_API_KEY=

# Optional overrides (defaults shown in src/config.js):
# PORT=8080
# AGENT_PATH=/agent
# VERIFIER_MODE=mock
# KURIER_BASE_URL=https://api.kurier.xyz/api/v1
# STATE_FILE=./data/state.json
